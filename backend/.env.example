# --- chain
# CHAIN_NETWORK must match a file name in app/chain/deployments/ (localhost | fuji | l1 | …)
# localhost = Hardhat node (docker compose / npm run node). fuji = Avalanche Fuji testnet.
# l1 = custom Avalanche L1 deployed with `npm run deploy:l1` in contracts/.
CHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# OrbiTag L1 (chainId 500301, AvaCloud managed):
# CHAIN_NETWORK=l1
# RPC_URL=https://managed-nodes.avax.network/ext/bc/25q34oCrUpLtwMWfnkCcfcKiH6ec84npvtSBy1bLGRyN4KiizF/rpc
# Explorer base for tx links. Empty: Snowtrace on fuji, no links on other chains
# (Snowtrace does not index custom L1s).
# EXPLORER_TX_URL=https://<your-explorer>/tx/
# Private key of the wallet with ORACLE_ROLE (needs native gas: the L1 gas token, or AVAX on Fuji). Never commit it.
# For localhost you can use Hardhat account #0 (the deployer), printed by `npx hardhat node`.
ORACLE_PRIVATE_KEY=

# --- data
MAX_CLOUD_COVER=30
MAX_SCENES=6
ANALYSIS_WINDOW_DAYS=90
# true = skip Sentinel-2 and always use the deterministic mock NDVI
FORCE_MOCK_NDVI=false
# true = skip Sentinel-1 (Planetary Computer) and use the deterministic mock radar series
FORCE_MOCK_SAR=false
# Latest Sentinel-2 scene cloudier than this (%) -> Sentinel-1 soil moisture takes priority
CLOUD_PRIORITY_THRESHOLD=20
# gamma0 VV (dB) under which the radar flags dry soil
SAR_DRY_SOIL_VV_DB=-14

# --- scoring weights (normalized) and references, see docs/scoring.md (agro-score-v2)
NDVI_REF_LOW=0.2
NDVI_REF_HIGH=0.8
EVI_REF_LOW=0.15
EVI_REF_HIGH=0.6
NDWI_REF_LOW=-0.1
NDWI_REF_HIGH=0.4
WEIGHT_VIGOR=0.35
WEIGHT_NDWI=0.15
WEIGHT_WATER=0.20
WEIGHT_STRESS=0.15
WEIGHT_HEAT=0.05
WEIGHT_SAR=0.10
HEAT_STRESS_TEMP_C=35
CRITICAL_DRY_DAYS_REF=20

# --- FAO-56 water balance
SOIL_AVAILABLE_WATER_M3_M3=0.15
INITIAL_DEPLETION_FRACTION=0.0

# --- parametric insurance trigger (keep in sync with CampaignVault.InsuranceParams)
NDWI_TRIGGER=0.05
RAIN_TRIGGER_RATIO=0.5
DRY_DAYS_TRIGGER=10
NDVI_DROP_TRIGGER=0.4
SOIL_DRY_DAYS_TRIGGER=21

# --- demo / scheduler
SIMULATE_DROUGHT=false
ENABLE_SCHEDULER=true
ORACLE_INTERVAL_MINUTES=30

# --- api
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4000
LOG_LEVEL=INFO
