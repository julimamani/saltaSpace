# Wallet that deploys the contracts on Fuji (needs test AVAX: https://core.app/tools/testnet-faucet/?subnet=c&token=c)
DEPLOYER_PRIVATE_KEY=
# Address that will receive ORACLE_ROLE (the backend's ORACLE_PRIVATE_KEY address). Defaults to the deployer.
ORACLE_ADDRESS=
# Address that receives COMPLIANCE_ROLE (verifies investors / KYC allowlist). Defaults to the deployer.
COMPLIANCE_ADDRESS=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
LOCAL_RPC_URL=http://127.0.0.1:8545
REPORT_GAS=false

# --- custom Avalanche L1 (optional) ---
# RPC + chainId of your L1 (subnet-evm). Setting L1_CHAIN_ID enables the `l1` network.
L1_RPC_URL=
L1_CHAIN_ID=
# solc evmVersion if your L1 runs an older EVM (default cancun): shanghai | paris | london
# EVM_VERSION=shanghai
# Use an existing ERC-20 as payment token instead of deploying MockUSDC
# (e.g. real USDC on Fuji: 0x5425890298aed601595a70AB815c96711a31Bc65 — must have 6 decimals)
# USDC_ADDRESS=
